# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Apify (actor sian.agency/smart-idealista-scraper)
APIFY_API_TOKEN=
APIFY_ACTOR_ID=sian.agency/smart-idealista-scraper
# Secreto propio (generar uno random) para validar el webhook de Apify por query string.
APIFY_INGEST_WEBHOOK_SECRET=

# Retell
RETELL_API_KEY=
RETELL_AGENT_ID=
# Número de pruebas por ahora (solo alcanza destinos de EE.UU.). El número
# español productivo requiere importarlo vía Twilio + SIP trunk en el
# dashboard de Retell — paso de configuración de cuenta, no de código.
RETELL_FROM_NUMBER=

# URL pública de esta app (usada para construir la URL del webhook de Apify).
APP_BASE_URL=http://localhost:3000
